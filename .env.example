# RaceLab works fully offline without this file.
# Run `./racelab configure` to choose OpenAI or Anthropic. It writes one active
# key and the matching default model.

# OPENAI_API_KEY=your-key-here
# RACING_MODEL=gpt-5.6-luna

# Or:
# ANTHROPIC_API_KEY=your-key-here
# RACING_MODEL=claude-sonnet-5

# Optional per-role overrides:
# RACING_MAIN_MODEL=gpt-5.6-luna
# RACING_ENVIRONMENT_CHAT_MODEL=gpt-5.6-luna
# RACING_PLAYER_MODEL=gpt-5.6-luna
# RACING_EXPERIMENT_MODEL=gpt-5.6-luna
